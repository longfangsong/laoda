# 复制为 .env 后填入真实值（.env 已 gitignore，不会进仓库）
# 由 build.rs 读成编译期变量，改动后重新 cargo build 生效

# WiFi 凭据（WPA2）
LAODA_WIFI_SSID=Your-SSID
LAODA_WIFI_PSK=Your-Password

# 推送鉴权 token（push 模块使用，设计文档 §8）
LAODA_PUSH_TOKEN=change-me

# 本地时区偏移秒数。默认 CEST（欧洲夏令时，UTC+2 = 7200）。
# 冬季 CET = 3600。不自动切换，见 docs/backlog.md
LAODA_TZ_OFFSET=7200
